mixin sPrice(data)
	// start sPrice
	+b.SECTION.sPrice.section#sPrice&attributes(attributes)
		+img('img/svg/ring.svg').ring.ring-top
		+img('img/svg/ring.svg').ring.ring-bottom
		.container
			+b.section-title.text-center.pricing
				h2 Прайс на пирсинг
				.sub Стоимость указана без учета украшений
			+e.inner-wrap
				- var masterType = ['Старший мастер', 'Гостевой мастер', 'Эксперт']
				+tableLg
				+e.btn-wrap.text-center
					+e.btn.btn.btn-dark(href='#') Записаться
	// end sPrice

mixin tableLg
	.table-wrap
		- var masterType = ['Старший мастер', 'Гостевой мастер', 'Эксперт']
		table
			thead
				tr
					th Название услуги
					th Старший мастер
					th Гостевой мастер
					th Эксперт
			tbody
				tr
					td Хрящи ушей (хлекс, конч, и т. д.)
					td(data-title=masterType[0])
						| 3 000 
					td(data-title=masterType[1])
						| 3 000 
					td(data-title=masterType[2])
						| 3 000 
				tr
					td Мочка, за один прокол
					td(data-title=masterType[0])
						| 3 000 
					td(data-title=masterType[1])
						| 3 000 
					td(data-title=masterType[2])
						| 3 000 
				tr
					td Двойные (индастриал, орбитал)
					td(data-title=masterType[0]) 6 000 
					td(data-title=masterType[1]) 6 000 
					td(data-title=masterType[2]) 6 000 
				tr
					td Крыло носа, септ ум, бридж
					td(data-title=masterType[0]) 3 000 
					td(data-title=masterType[1]) 3 000 
					td(data-title=masterType[2]) 3 000 
				tr
					td Язык, пупок, бровь, губа
					td(data-title=masterType[0]) 3 000 
					td(data-title=masterType[1]) 3 000 
					td(data-title=masterType[2]) 3 000 
				tr
					td Сосок, за один прокол
					td(data-title=masterType[0]) 3 000 
					td(data-title=masterType[1]) 3 000 
					td(data-title=masterType[2]) 3 000 
				tr
					td Микродермал
					td(data-title=masterType[0]) 3 000 
					td(data-title=masterType[1]) 3 000 
					td(data-title=masterType[2]) 3 000 
				tr
					td Генитальные
					td(data-title=masterType[0]) 6 000 
					td(data-title=masterType[1]) 6 000 
					td(data-title=masterType[2]) 6 000 
				tr
					td Восстановление прокола
					td(data-title=masterType[0]) 1 400
					td(data-title=masterType[1]) 1 400
					td(data-title=masterType[2]) 1 400
				tr
					td Растягивание тоннеля (шаг от 1 до 3 мм)
					td(data-title=masterType[0]) 1 400
					td(data-title=masterType[1]) 1 400
					td(data-title=masterType[2]) 1 400